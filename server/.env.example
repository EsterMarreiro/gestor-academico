DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestor_academico"
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
SERVICE_NAME=gestor-academico-gateway
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=
REDIS_USERNAME=
REDIS_PASSWORD=
RABBITMQ_URL=amqp://gestor:gestor@127.0.0.1:5672
METRICS_DEFAULT_PREFIX=gestor_academico_
HEALTHCHECK_EXTERNAL_TIMEOUT_MS=2000
EXTERNAL_SERVICES=
RESILIENCE_RETRY_ATTEMPTS=3
RESILIENCE_RETRY_INITIAL_DELAY_MS=200
RESILIENCE_RETRY_MAX_DELAY_MS=3000
RESILIENCE_TIMEOUT_MS=2500
RESILIENCE_RPC_TIMEOUT_MS=10000
RESILIENCE_EXTERNAL_HTTP_TIMEOUT_MS=5000
RESILIENCE_CIRCUIT_BREAKER_THRESHOLD=5
RESILIENCE_CIRCUIT_BREAKER_HALF_OPEN_AFTER_MS=15000
RESILIENCE_CIRCUIT_BREAKER_TIMEOUT_MS=12000
RESILIENCE_BULKHEAD_LIMIT=50
RESILIENCE_BULKHEAD_QUEUE_LIMIT=100
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
