{
  "name": "server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:gateway:dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "start:dev": "prisma generate && concurrently -c auto -n gateway,usuarios-ms,turmas-ms,cursos-ms,disciplinas-ms,matriculas-ms,aulas-ms,alunos-ms,professores-ms \"npm run start:gateway:dev\" \"npm run start:usuarios-ms:dev\" \"npm run start:turmas-ms:dev\" \"npm run start:cursos-ms:dev\" \"npm run start:disciplinas-ms:dev\" \"npm run start:matriculas-ms:dev\" \"npm run start:aulas-ms:dev\" \"npm run start:alunos-ms:dev\" \"npm run start:professores-ms:dev\"",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "start:usuarios-ms": "node dist/main.usuarios-ms.js",
    "start:turmas-ms": "node dist/main.turmas-ms.js",
    "start:cursos-ms": "node dist/main.cursos-ms.js",
    "start:disciplinas-ms": "node dist/main.disciplinas-ms.js",
    "start:matriculas-ms": "node dist/main.matriculas-ms.js",
    "start:matriculas-rmq-consumer": "node dist/main.matriculas-rmq-consumer.js",
    "start:aulas-ms": "node dist/main.aulas-ms.js",
    "start:alunos-ms": "node dist/main.alunos-ms.js",
    "start:professores-ms": "node dist/main.professores-ms.js",
    "start:usuarios-ms:dev": "ts-node -r tsconfig-paths/register src/main.usuarios-ms.ts",
    "start:turmas-ms:dev": "ts-node -r tsconfig-paths/register src/main.turmas-ms.ts",
    "start:cursos-ms:dev": "ts-node -r tsconfig-paths/register src/main.cursos-ms.ts",
    "start:disciplinas-ms:dev": "ts-node -r tsconfig-paths/register src/main.disciplinas-ms.ts",
    "start:matriculas-ms:dev": "ts-node -r tsconfig-paths/register src/main.matriculas-ms.ts",
    "start:matriculas-rmq-consumer:dev": "ts-node -r tsconfig-paths/register src/main.matriculas-rmq-consumer.ts",
    "start:aulas-ms:dev": "ts-node -r tsconfig-paths/register src/main.aulas-ms.ts",
    "start:alunos-ms:dev": "ts-node -r tsconfig-paths/register src/main.alunos-ms.ts",
    "start:professores-ms:dev": "ts-node -r tsconfig-paths/register src/main.professores-ms.ts",
    "start:stack:dev": "npm run start:dev",
    "lint": "eslint src --ext .ts --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/microservices": "^11.1.19",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/swagger": "^11.2.6",
    "@prisma/client": "^6.19.3",
    "@socket.io/redis-adapter": "^8.0.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "cache-manager": "^7.2.8",
    "cache-manager-redis-store": "^3.0.0",
    "class-transformer": "^0.5.1",
    "joi": "^17.10.0",
    "class-validator": "^0.14.4",
    "redis": "^4.7.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.17",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^4.17.18",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
